# Local: start a Postgres with `npx prisma dev --name wedcount --detach` (no Docker) and paste the
# postgres:// URL it prints into both lines, using 127.0.0.1 and connection_limit=1 as below.
# Production (Vercel + Neon): DATABASE_URL = Neon pooled URL (host has -pooler), DATABASE_URL_UNPOOLED = Neon direct URL.
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:51214/template1?sslmode=disable&connection_limit=1&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgres://postgres:postgres@127.0.0.1:51214/template1?sslmode=disable&connection_limit=1&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0&pgbouncer=true"

# Public base URL used in guest invite links. Required in production.
APP_URL="http://localhost:3000"

# Optional: shown as the contact address on /privacy and /terms.
SUPPORT_EMAIL=""
