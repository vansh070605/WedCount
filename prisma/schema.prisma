generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Planner {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
  weddings     Wedding[]
}

// Login session. Only the SHA-256 of the cookie token is stored, so a leaked DB can't log anyone in.
model Session {
  id        String   @id // sha256(token)
  plannerId String
  planner   Planner  @relation(fields: [plannerId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([plannerId])
}

model Wedding {
  id          String   @id @default(cuid())
  plannerId   String
  planner     Planner  @relation(fields: [plannerId], references: [id], onDelete: Cascade)
  name        String
  city        String?
  rsvpDeadline DateTime?
  createdAt   DateTime @default(now())
  events      Event[]
  guests      Guest[]

  @@index([plannerId])
}

// One wedding has several functions: haldi, sangeet, wedding, reception.
model Event {
  id        String   @id @default(cuid())
  weddingId String
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name      String
  startsAt  DateTime
  venue     String?
  // People who actually came, entered by the planner afterwards. Calibrates future predictions.
  actualCount Int?
  rsvps     Rsvp[]

  @@index([weddingId])
}

model Guest {
  id        String   @id @default(cuid())
  weddingId String
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  side      String   // "bride" | "groom"
  relation  String   // "family" | "friend" | "colleague" | "other"
  // Secret part of the personal invite link; never expose guest ids in URLs.
  // Set in code with crypto randomness (lib/guests.ts newGuestToken): cuid() is guessable.
  token     String   @unique
  createdAt DateTime @default(now())
  // When the planner last opened WhatsApp to invite / remind this guest. A click, not proof of delivery.
  invitedAt     DateTime?
  remindedAt    DateTime?
  reminderCount Int       @default(0)
  rsvps     Rsvp[]

  @@unique([weddingId, phone])
  @@index([weddingId])
}

// A guest's answer for one event. Missing row means no reply yet.
// Headcount is vegCount + nonVegCount, so the two can never disagree.
model Rsvp {
  id          String   @id @default(cuid())
  guestId     String
  guest       Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status      String   // "attending" | "declined" | "maybe"
  vegCount    Int      @default(0)
  nonVegCount Int      @default(0)
  arrivalTime DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([guestId, eventId])
  @@index([eventId])
}
