generator client {
  provider = "prisma-client-js"
}

// Postgres on Neon in production. DATABASE_URL is the pooled connection the app uses;
// DATABASE_URL_UNPOOLED bypasses the pooler for migrations. Locally both point at `npx prisma dev`.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Planner {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  // Login lockout: see lib/lockout.ts. Stored in the DB because serverless runs many copies of the app.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  sessions     Session[]
  weddings     Wedding[]
  resets       PasswordReset[]
}

// Login session. Only the SHA-256 of the cookie token is stored, so a leaked DB can't log anyone in.
model Session {
  id        String   @id // sha256(token)
  plannerId String
  planner   Planner  @relation(fields: [plannerId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([plannerId])
}

model Wedding {
  id          String   @id @default(cuid())
  plannerId   String
  planner     Planner  @relation(fields: [plannerId], references: [id], onDelete: Cascade)
  name        String
  city        String?
  rsvpDeadline DateTime?
  // Planner's own WhatsApp invite text with {name} {wedding} {functions} {deadline} {link}; null = default.
  inviteTemplate String?
  createdAt   DateTime @default(now())
  events      Event[]
  guests      Guest[]

  @@index([plannerId])
}

// One wedding has several functions: haldi, sangeet, wedding, reception.
model Event {
  id        String   @id @default(cuid())
  weddingId String
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name      String
  startsAt  DateTime
  venue     String?
  // People who actually came, entered by the planner afterwards. Calibrates future predictions.
  actualCount Int?
  rsvps     Rsvp[]
  invitations Invitation[]

  @@index([weddingId])
}

model Guest {
  id        String   @id @default(cuid())
  weddingId String
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  side      String   // "bride" | "groom"
  relation  String   // "family" | "friend" | "colleague" | "other"
  // Secret part of the personal invite link; never expose guest ids in URLs.
  // Set in code with crypto randomness (lib/guests.ts newGuestToken): cuid() is guessable.
  token     String   @unique
  createdAt DateTime @default(now())
  // When the planner last opened WhatsApp to invite / remind this guest. A click, not proof of delivery.
  invitedAt     DateTime?
  remindedAt    DateTime?
  reminderCount Int       @default(0)
  rsvps     Rsvp[]
  // Functions this guest is invited to. No rows = every function of the wedding (the common case).
  invitations Invitation[]

  @@unique([weddingId, phone])
  @@index([weddingId])
}

// A guest's answer for one event. Missing row means no reply yet.
// Headcount is vegCount + nonVegCount, so the two can never disagree.
model Rsvp {
  id          String   @id @default(cuid())
  guestId     String
  guest       Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status      String   // "attending" | "declined" | "maybe"
  vegCount    Int      @default(0)
  nonVegCount Int      @default(0)
  arrivalTime DateTime?
  // Names of everyone in the party, one per person (vegCount + nonVegCount of them when Coming).
  names       String[] @default([])
  updatedAt   DateTime @updatedAt

  @@unique([guestId, eventId])
  @@index([eventId])
}

// Fixed-window counters for abuse limits (see lib/ratelimit.ts). key = sha256 of "<action>:<client ip>",
// so raw IP addresses are never stored.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

// One-time password reset link. Only sha256(token) is stored, like sessions. See lib/reset.ts.
model PasswordReset {
  id        String    @id // sha256(token)
  plannerId String
  planner   Planner   @relation(fields: [plannerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?

  @@index([plannerId])
}

// A guest invited to only some functions (e.g. colleagues to the Reception). See Guest.invitations.
model Invitation {
  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([guestId, eventId])
  @@index([eventId])
}
